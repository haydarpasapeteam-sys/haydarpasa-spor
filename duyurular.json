// Duyuruları JSON dosyasından dinamik çeken güncel motor
    async function loadDuyurular() {
      const container = document.getElementById('duyuruContainer');
      if (!container) return;

      try {
        // Tarayıcı önbelleğine takılmaması için timestamp ekliyoruz
        const response = await fetch('duyurular.json?v=' + Date.now());
        if (!response.ok) {
          throw new Error('duyurular.json dosyası okunamadı!');
        }
        
        const veri = await response.json();

        // JSON yapınızda {"liste": [...]} olduğu için listeyi alıyoruz
        const duyurular = Array.isArray(veri) ? veri : (veri.liste || []);

        if (duyurular.length === 0) {
          container.innerHTML = '<div class="text-center py-8 text-white/80 font-bold text-sm w-full">Henüz aktif duyuru bulunmamaktadır.</div>';
          return;
        }

        container.innerHTML = duyurular.map(item => {
          let buttonsHtml = '';
          if (item.form_linki && item.belge_linki) {
            buttonsHtml = `
              <div class="flex gap-2">
                <a href="${item.form_linki}" target="_blank" class="flex-1 py-1.5 px-3 rounded-lg bg-red-600 hover:bg-red-700 text-white font-bold text-center text-xs shadow-sm transition">
                  Başvuru / Form
                </a>
                <a href="${item.belge_linki}" target="_blank" class="flex-1 py-1.5 px-3 rounded-lg bg-amber-500 hover:bg-amber-600 text-white font-bold text-center text-xs shadow-sm transition">
                  İzin Belgesi
                </a>
              </div>
            `;
          } else if (item.form_linki) {
            buttonsHtml = `
              <a href="${item.form_linki}" target="_blank" class="w-full block py-2 px-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs text-center transition shadow">
                Detay / Sonuç Listesi
              </a>
            `;
          }

          return `
            <div class="w-[300px] shrink-0 bg-white rounded-2xl p-4 flex flex-col justify-between shadow-lg border-t-4 border-t-red-600 hover:shadow-xl transition">
              <div>
                <div class="w-full h-36 rounded-xl overflow-hidden bg-slate-900 border border-slate-100 mb-3 shadow-inner">
                  <img src="${item.resim || 'anasayfa.png'}" alt="${item.baslik}" class="w-full h-full object-cover" onerror="this.src='anasayfa.png'" />
                </div>
                <div class="flex items-center justify-between text-[11px] mb-1.5">
                  <span class="font-black text-red-600 bg-red-50 px-2 py-0.5 rounded-md">${item.kategori || 'DUYURU'}</span>
                  <span class="text-slate-400 font-bold">${item.tarih_saat || ''}</span>
                </div>
                <h3 class="text-sm font-black text-slate-900">${item.baslik}</h3>
                <p class="text-xs text-slate-500 mt-1 leading-snug">${item.aciklama || ''}</p>
              </div>
              <div class="mt-4 pt-3 border-t border-slate-100">
                ${buttonsHtml}
              </div>
            </div>
          `;
        }).join('');

        // Üzerine gelindiğinde durma dinleyicileri
        container.addEventListener('mouseenter', stopAutoScroll);
        container.addEventListener('mouseleave', resumeAutoScroll);
        container.addEventListener('touchstart', stopAutoScroll, { passive: true });
        container.addEventListener('touchend', resumeAutoScroll, { passive: true });

        startAutoScroll();

      } catch (err) {
        console.error('Duyuru getirme hatası:', err);
        container.innerHTML = '<div class="text-center py-8 text-white/80 font-bold text-sm w-full">Duyurular yüklenemedi. Lütfen duyurular.json dosyasını kontrol edin.</div>';
      }
    }
