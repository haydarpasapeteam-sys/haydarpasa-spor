};
---
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={rest['aria-hidden'] ?? 'true'}
  focusable="false"
>
  <path d={paths[name]} />
</svg>
