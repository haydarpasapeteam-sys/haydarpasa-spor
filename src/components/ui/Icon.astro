---
/**
 * Small, tree-shaken inline-SVG icon set. Replaces the legacy
 * `<script src="https://unpkg.com/lucide@latest">` CDN dependency — no
 * runtime icon library, no extra network request, no unversioned script.
 */
export type IconName =
  | 'home' | 'bell-ring' | 'trophy' | 'flame' | 'book-open' | 'landmark'
  | 'file-text' | 'mail' | 'users' | 'calendar' | 'clock' | 'map-pin'
  | 'globe' | 'instagram' | 'shield-check' | 'folder-open' | 'external-link'
  | 'chevron-left' | 'chevron-right' | 'menu' | 'check' | 'circle' | 'target'
  | 'racket' | 'image-off' | 'download' | 'lock';

interface Props {
  name: IconName;
  class?: string;
  'aria-hidden'?: boolean | 'true' | 'false';
}

const { name, class: className = '', ...rest } = Astro.props;

const paths: Record<IconName, string> = {
