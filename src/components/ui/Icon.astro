  'bell-ring': 'M18 8a6 6 0 1 0-12 0c0 3.2-1 4.6-2 6h16c-1-1.4-2-2.8-2-6ZM9.5 19a2.5 2.5 0 0 0 5 0M3 6l2-2M21 6l-2-2',
  trophy: 'M8 4h8v4a4 4 0 0 1-8 0V4ZM6 6H4a2 2 0 0 0 2 4M18 6h2a2 2 0 0 1-2 4M10 15h4v3H10zM8 21h8',
  flame: 'M12 2c1 4-4 5-4 9a4 4 0 0 0 8 0c1 1.5 1 3 1 3a6 6 0 1 1-11-3c0-4 4-5 6-9Z',
  'book-open': 'M12 6c-2-1.5-5-2-8-1v13c3-1 6-.5 8 1 2-1.5 5-2 8-1V5c-3-1-6-.5-8 1ZM12 6v14',
  landmark: 'M3 21h18M4 10h16M12 3 3 8h18L12 3ZM6 10v9M10 10v9M14 10v9M18 10v9',
  'file-text': 'M7 3h7l4 4v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1ZM14 3v4h4M9 12h6M9 15.5h6M9 9h2',
  mail: 'M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1ZM3.5 6l8.5 6.5L20.5 6',
  users: 'M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM3 20c0-3.5 2.7-6 6-6s6 2.5 6 6M17 11a3 3 0 1 0 0-6M17.5 14c2.4.4 4.5 2.4 4.5 6',
  calendar: 'M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1ZM8 2v4M16 2v4M4 9h16M8 13h2M8 17h2',
  clock: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM12 7v5l3.5 2',
  'map-pin': 'M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21ZM12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
