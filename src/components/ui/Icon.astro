  instagram: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4ZM12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7ZM17 6.7h.01',
  'shield-check': 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3ZM9 12l2 2 4-4.5',
  'folder-open': 'M3 8a1 1 0 0 1 1-1h5l2 2h9a1 1 0 0 1 1 1l-2 9a1 1 0 0 1-1 .8H5.5a1 1 0 0 1-1-.8L3 8Z',
  'external-link': 'M14 4h6v6M20 4 10 14M20 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5',
  'chevron-left': 'M15 5 8 12l7 7',
  'chevron-right': 'M9 5l7 7-7 7',
  menu: 'M4 6h16M4 12h16M4 18h16',
  check: 'M4 12.5 9.5 18 20 6',
  circle: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z',
  target: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM12 12h.01',
  racket: 'M9 14a5 5 0 1 0 0-10 5 5 0 0 0 0 10ZM7.5 15.5 3 20M9 14l2 2',
  'image-off': 'M4 4l16 16M5 5v13a1 1 0 0 0 1 1h13M20 16V6a1 1 0 0 0-1-1H9',
  download: 'M12 3v12m0 0-4-4m4 4 4-4M4 17v2a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-2',
