---
import ResponsiveImage from '../ui/ResponsiveImage.astro';
import { isSafeExternalUrl } from '../../lib/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'galleries'>;
}
const { entry } = Astro.props;
const { title, event, description, coverImage, coverImageAlt, externalUrl } = entry.data;
---
<article class="gallery-card">
  {coverImage && (
    <div class="gallery-media">
      <ResponsiveImage src={coverImage} alt={coverImageAlt ?? ''} sizes="(min-width: 1024px) 320px, 100vw" />
    </div>
  )}
  <div class="gallery-body">
    <h3 class="gallery-title">{title}</h3>
    <p class="gallery-event">{event}</p>
    <p class="gallery-desc">{description}</p>
    {externalUrl && isSafeExternalUrl(externalUrl) && (
      <a href={externalUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary touch-target">
        Albümü Aç
      </a>
    )}
  </div>
</article>

<style>
  .gallery-card {
    background: #fff;
    color: var(--color-ink);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .gallery-media {
    aspect-ratio: 4 / 3;
    background: #0f172a;
  }
  .gallery-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gallery-body {
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }
  .gallery-title {
    font-size: 1rem;
    font-weight: 900;
    margin: 0;
    color: var(--color-primary);
  }
  .gallery-event {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-muted);
    margin: 0;
    text-transform: uppercase;
  }
  .gallery-desc {
    font-size: 0.8rem;
    color: var(--color-ink-soft);
    line-height: 1.45;
    margin: 0 0 0.5rem;
    flex: 1;
  }
</style>
