---
import { withBase } from '../../lib/url';
import Icon from '../ui/Icon.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'documents'>;
}
const { entry } = Astro.props;
const { title, category, summary, file, printablePage, versionDate } = entry.data;
const versionLabel = new Intl.DateTimeFormat('tr-TR', { month: 'long', year: 'numeric', timeZone: 'Europe/Istanbul' }).format(versionDate);
---
<article class="doc-card">
  <span class="pill" style="background:#ede9fe; color:#5b21b6;">{category}</span>
  <h3 class="doc-card-title">{title}</h3>
  <p class="doc-card-summary">{summary}</p>
  <p class="doc-card-version">Sürüm: {versionLabel}</p>
  <div class="doc-card-actions">
    {printablePage && (
      <a href={withBase(`${printablePage}/`)} class="btn btn-secondary touch-target">
        <Icon name="file-text" class="btn-icon" /> Görüntüle
      </a>
    )}
    <a href={withBase(file)} class="btn btn-primary touch-target" download>
      <Icon name="download" class="btn-icon" /> PDF İndir
    </a>
  </div>
</article>

<style>
  .doc-card {
    background: #fff;
    color: var(--color-ink);
    border-radius: var(--radius-card-sm);
    box-shadow: var(--shadow-card);
    padding: 1.1rem;
  }
  .doc-card-title {
    font-size: 0.92rem;
    font-weight: 800;
    margin: 0.5rem 0 0.3rem;
  }
  .doc-card-summary {
    font-size: 0.78rem;
    color: var(--color-muted);
    margin: 0 0 0.4rem;
    line-height: 1.4;
  }
  .doc-card-version {
    font-size: 0.68rem;
    color: var(--color-muted);
    margin: 0 0 0.75rem;
  }
  .doc-card-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .btn-icon {
    width: 14px;
    height: 14px;
  }
</style>
