---
import { withBase } from '../../lib/url';
import ResponsiveImage from '../ui/ResponsiveImage.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'announcements'>;
}
const { entry } = Astro.props;
const { title, summary, category, coverImage, coverImageAlt, publishAt } = entry.data;

const categoryColors: Record<string, string> = {
  'Duyuru': '#c40018',
  'Takım Seçmeleri': '#1d4ed8',
  Turnuva: '#92400e', // darker than the brand's b45309 amber — b45309 fails WCAG AA (4.35:1) on its own 10%-tint pill background
  'Maç Sonucu': '#065f46',
  Belge: '#6b21a8',
  Etkinlik: '#be185d',
};
const accent = categoryColors[category] ?? '#c40018';
const dateLabel = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', timeZone: 'Europe/Istanbul' }).format(publishAt);
---
<a href={withBase(`/duyurular/${entry.id}/`)} class="ann-card" style={`--accent:${accent}`}>
  {coverImage && (
    <div class="ann-card-media">
      <ResponsiveImage src={coverImage} alt={coverImageAlt ?? ''} sizes="(min-width: 1024px) 320px, 100vw" />
    </div>
  )}
  <div class="ann-card-body">
    <div class="ann-card-meta">
      <span class="pill" style={`background:${accent}1a; color:${accent};`}>{category}</span>
      <span class="ann-card-date">{dateLabel}</span>
    </div>
    <h3 class="ann-card-title">{title}</h3>
    <p class="ann-card-summary">{summary}</p>
  </div>
</a>

<style>
  .ann-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    color: var(--color-ink);
    border-radius: var(--radius-card-sm);
    box-shadow: var(--shadow-card);
    border-left: 4px solid var(--accent);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.15s ease;
    height: 100%;
  }
  .ann-card:hover {
    transform: translateY(-2px);
  }
  .ann-card-media {
    aspect-ratio: 16 / 10;
    background: #0f172a;
    overflow: hidden;
  }
  .ann-card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ann-card-body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }
  .ann-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .ann-card-date {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--color-muted);
  }
  .ann-card-title {
    font-size: 0.95rem;
    font-weight: 800;
    margin: 0;
  }
  .ann-card-summary {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.4;
  }
</style>
