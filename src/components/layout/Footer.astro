---
import { withBase } from '../../lib/url';
import site from '../../data/site.json';
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <p class="footer-title">{site.schoolName} — {site.departmentName}</p>
      <p class="footer-copy">{site.footerText}</p>
    </div>
    <nav aria-label="Alt bilgi bağlantıları" class="footer-links">
      <a href={site.officialSchoolWebsite} target="_blank" rel="noopener noreferrer">Resmi Okul Sitesi</a>
      <a href={`mailto:${site.publicEmail}`}>{site.publicEmail}</a>
      <a href={withBase('/yonetim/')}>Yönetim</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary-dark);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-block: 2rem;
    margin-top: auto;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    text-align: left;
    font-size: 0.8rem;
  }

  @media (min-width: 640px) {
    .footer-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .footer-title {
    font-weight: 700;
    margin: 0 0 0.25rem;
  }

  .footer-copy {
    color: #ffdede;
    margin: 0;
    font-size: 0.75rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .footer-links a {
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.4);
  }

  .footer-links a:hover {
    text-decoration-color: #fff;
  }
</style>
