---
import { withBase } from '../../lib/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'teams'>;
  sportName: string;
}
const { entry, sportName } = Astro.props;
const { name, season, ageOrClassGroup, summary, coachOrTeacher } = entry.data;
---
<a href={withBase(`/takimlar/${entry.id}/`)} class="team-card">
  <span class="pill" style="background:#fef3c7; color:#92400e;">{sportName}</span>
  <h3 class="team-name">{name}</h3>
  <p class="team-summary">{summary}</p>
  <dl class="team-meta">
    <div><dt>Sezon</dt><dd>{season}</dd></div>
    <div><dt>Kategori</dt><dd>{ageOrClassGroup}</dd></div>
    {coachOrTeacher && <div><dt>Sorumlu Öğretmen</dt><dd>{coachOrTeacher}</dd></div>}
  </dl>
</a>

<style>
  .team-card {
    display: block;
    background: #fff;
    color: var(--color-ink);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: 1.25rem;
    text-decoration: none;
    border-top: 4px solid var(--color-amber);
    transition: transform 0.15s ease;
  }
  .team-card:hover {
    transform: translateY(-2px);
  }
  .team-name {
    font-size: 1.05rem;
    font-weight: 900;
    margin: 0.5rem 0 0.35rem;
  }
  .team-summary {
    font-size: 0.82rem;
    color: var(--color-muted);
    margin: 0 0 0.75rem;
    line-height: 1.4;
  }
  .team-meta {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    border-top: 1px solid var(--color-border-soft);
    padding-top: 0.6rem;
  }
  .team-meta div {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    gap: 0.5rem;
  }
  .team-meta dt {
    color: var(--color-muted);
    font-weight: 600;
  }
  .team-meta dd {
    margin: 0;
    font-weight: 700;
    text-align: right;
  }
</style>
