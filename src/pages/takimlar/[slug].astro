---
import { render, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveImage from '../../components/ui/ResponsiveImage.astro';
import Icon from '../../components/ui/Icon.astro';
import { withBase } from '../../lib/url';
import { getActiveTeams } from '../../lib/queries';

export async function getStaticPaths() {
  const entries = await getActiveTeams();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name, season, ageOrClassGroup, summary, coachOrTeacher, coverImage, coverImageAlt } = entry.data;
const sport = await getEntry('sports', entry.data.sport.id);
---
<BaseLayout title={name} description={summary} path={`/takimlar/${entry.id}`}>
  <div class="container detail-stack">
    <a href={withBase('/takimlar/')} class="back-link"><Icon name="chevron-left" /> Tüm Takımlar</a>
    <article class="card detail-card">
      {coverImage && (
        <div class="detail-media">
          <ResponsiveImage src={coverImage} alt={coverImageAlt ?? ''} priority sizes="(min-width: 1024px) 800px, 100vw" />
        </div>
      )}
      <div class="detail-body">
        <span class="pill" style="background:#fef3c7; color:#92400e;">{sport?.data.name ?? entry.data.sport.id}</span>
        <h1>{name}</h1>
        <p class="detail-summary">{summary}</p>
        <dl class="team-meta-list">
          <div><dt>Sezon</dt><dd>{season}</dd></div>
          <div><dt>Kategori</dt><dd>{ageOrClassGroup}</dd></div>
          {coachOrTeacher && <div><dt>Sorumlu Öğretmen</dt><dd>{coachOrTeacher}</dd></div>}
        </dl>
        <div class="detail-content"><Content /></div>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .detail-stack { padding-block: 1.5rem 3rem; display: flex; flex-direction: column; gap: 1.25rem; max-width: 56rem; margin-inline: auto; }
  .back-link { display: inline-flex; align-items: center; gap: 0.3rem; color: #ffdede; text-decoration: none; font-size: 0.8rem; font-weight: 700; }
  .detail-media { aspect-ratio: 16/9; overflow: hidden; border-radius: var(--radius-card) var(--radius-card) 0 0; }
  .detail-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .detail-body { padding: 1.5rem; }
  .detail-body h1 { font-size: 1.5rem; font-weight: 900; margin: 0.5rem 0; }
  .detail-summary { color: var(--color-muted); margin: 0 0 1rem; }
  .team-meta-list { display: grid; gap: 0.4rem; margin: 0 0 1rem; padding: 0.75rem; background: #f8fafc; border-radius: var(--radius-card-sm); }
  .team-meta-list div { display: flex; justify-content: space-between; font-size: 0.82rem; }
  .team-meta-list dt { color: var(--color-muted); font-weight: 600; }
  .team-meta-list dd { margin: 0; font-weight: 700; }
  .detail-content { font-size: 0.92rem; line-height: 1.7; color: var(--color-ink-soft); }
</style>
