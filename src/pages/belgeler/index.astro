---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocumentCard from '../../components/documents/DocumentCard.astro';
import Icon from '../../components/ui/Icon.astro';
import { getActiveDocuments } from '../../lib/queries';

const documents = await getActiveDocuments();
const byCategory = new Map<string, typeof documents>();
for (const doc of documents) {
  const list = byCategory.get(doc.data.category) ?? [];
  list.push(doc);
  byCategory.set(doc.data.category, list);
}
---
<BaseLayout
  title="Belgeler"
  description="Haydarpaşa Lisesi Beden Eğitimi ve Spor Bölümü resmi izin belgeleri, sağlık beyanı ve İSG talimatları."
  path="/belgeler/"
>
  <div class="container page-stack">
    <header class="page-header">
      <Icon name="file-text" class="page-header-icon" />
      <div>
        <h1>Zorunlu Resmi Evraklar</h1>
        <p>İzin belgeleri, sağlık beyanı, taahhütname ve İSG talimatları</p>
      </div>
    </header>

    {[...byCategory.entries()].map(([category, docs]) => (
      <section>
        <h2 class="category-heading">{category}</h2>
        <div class="grid-cards">
          {docs.map((entry) => <DocumentCard entry={entry} />)}
        </div>
      </section>
    ))}

    <section>
      <h2 class="category-heading">E-Portfolyo</h2>
      <div class="grid-cards">
        <a class="card doc-card" href="https://drive.google.com/file/d/16s5oAwvkPGmqaWai1vAoTRjFFg1M0XhK/view?usp=share_link" target="_blank" rel="noopener noreferrer" style="padding:1.1rem; text-decoration:none; color:var(--color-ink);">
          <span class="pill" style="background:#ede9fe; color:#5b21b6;">E-Portfolyo 1</span>
          <h3 style="font-size:0.9rem; font-weight:800; margin:0.5rem 0 0.3rem;">Beden Eğitimi Dersi Öğrenci E-Portfolyo Detaylı Formu</h3>
          <p style="font-size:0.78rem; color:var(--color-muted); margin:0;">Fiziksel profil, branş teknik gelişimi, dijital proje ve iş birliği değerlendirme formu.</p>
        </a>
        <a class="card doc-card" href="https://drive.google.com/file/d/1ivrJqoqNpAz_l0vnJKQznSSBuWQo_32S/view?usp=share_link" target="_blank" rel="noopener noreferrer" style="padding:1.1rem; text-decoration:none; color:var(--color-ink);">
          <span class="pill" style="background:#fef3c7; color:#92400e;">E-Portfolyo 2</span>
          <h3 style="font-size:0.9rem; font-weight:800; margin:0.5rem 0 0.3rem;">Öğrenci E-Portfolyo Özet Gelişim Dosyası Şablonu</h3>
          <p style="font-size:0.78rem; color:var(--color-muted); margin:0;">Esneklik, denge testleri takip tablosu ve dönem sonu kontrol listesi.</p>
        </a>
      </div>
    </section>

    <section class="card pending-notice">
      <Icon name="clock" class="pending-icon" />
      <div>
        <h3>Öğrenci Taahhütnamesi — Dosya Bekleniyor</h3>
        <p>
          Bu belgenin okul tarafından onaylanmış resmî sürümü henüz teslim edilmediği için burada
          yayınlanmamıştır. Belge okul idaresi tarafından sağlandığında Pages CMS üzerinden eklenecektir.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-stack { padding-block: 1.5rem 3rem; display: flex; flex-direction: column; gap: 1.75rem; }
  .page-header { display: flex; align-items: center; gap: 0.85rem; }
  .page-header-icon { width: 30px; height: 30px; background: var(--color-amber-light); color: #1e293b; padding: 0.5rem; border-radius: var(--radius-card-sm); }
  .page-header h1 { font-size: 1.4rem; font-weight: 900; text-transform: uppercase; margin: 0; }
  .page-header p { font-size: 0.78rem; color: #ffdede; margin: 0.2rem 0 0; }
  .category-heading { font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: #ffdede; margin: 0 0 0.75rem; }
  .grid-cards { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 768px) { .grid-cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid-cards { grid-template-columns: repeat(3, 1fr); } }
  .pending-notice { display: flex; gap: 0.75rem; padding: 1.1rem; background: #fffbeb; border: 1px solid #fde68a; color: #92400e; }
  .pending-icon { width: 24px; height: 24px; flex-shrink: 0; }
  .pending-notice h3 { font-size: 0.85rem; margin: 0 0 0.3rem; }
  .pending-notice p { font-size: 0.78rem; margin: 0; line-height: 1.5; }
</style>
