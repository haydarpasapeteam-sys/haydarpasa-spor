---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MatchCard from '../../components/matches/MatchCard.astro';
import Icon from '../../components/ui/Icon.astro';
import { getPublishedMatches } from '../../lib/queries';

const matches = await getPublishedMatches();
---
<BaseLayout title="Maçlar" description="Haydarpaşa Lisesi okul takımlarının maç sonuçları ve fikstürü." path="/maclar/">
  <div class="container page-stack">
    <header class="page-header">
      <Icon name="trophy" class="page-header-icon" />
      <div>
        <h1>Maçlar</h1>
        <p>Okul takımlarımızın maç sonuçları ve fikstürü</p>
      </div>
    </header>

    <section class="card embed-card">
      <h2 class="embed-heading">Futsal All-Star Turnuvası — Canlı Skor Tablosu</h2>
      <div class="embed-wrap">
        <iframe
          loading="lazy"
          title="Futsal All-Star Turnuvası canlı skor tablosu (Canva)"
          src="https://www.canva.com/design/DAHWAiKceMM/2gsHrKzP-ie6Cd9LBlMcQA/view?embed"
          allowfullscreen="allowfullscreen"
          allow="fullscreen"
        ></iframe>
      </div>
    </section>

    {matches.length > 0 ? (
      <div class="grid-cards">
        {matches.map((entry) => <MatchCard entry={entry} />)}
      </div>
    ) : (
      <p class="empty-state">
        Henüz yayınlanmış bir maç kaydı bulunmuyor. Beden Eğitimi öğretmenimiz maç sonuçlarını Pages CMS üzerinden
        eklediğinde burada listelenecektir.
      </p>
    )}
  </div>
</BaseLayout>

<style>
  .page-stack { padding-block: 1.5rem 3rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .page-header { display: flex; align-items: center; gap: 0.85rem; }
  .page-header-icon { width: 30px; height: 30px; background: var(--color-amber-light); color: #1e293b; padding: 0.5rem; border-radius: var(--radius-card-sm); }
  .page-header h1 { font-size: 1.4rem; font-weight: 900; text-transform: uppercase; margin: 0; }
  .page-header p { font-size: 0.78rem; color: #ffdede; margin: 0.2rem 0 0; }
  .grid-cards { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 768px) { .grid-cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid-cards { grid-template-columns: repeat(3, 1fr); } }
  .empty-state { background: rgba(255,255,255,0.1); border-radius: var(--radius-card-sm); padding: 1.5rem; text-align: center; color: #ffdede; font-size: 0.85rem; line-height: 1.5; }
  .embed-card { padding: 1.25rem; }
  .embed-heading { font-size: 0.95rem; font-weight: 800; margin: 0 0 0.75rem; color: var(--color-primary); }
  .embed-wrap { position: relative; width: 100%; padding-top: 50%; border-radius: var(--radius-card-sm); overflow: hidden; background: #0f172a; }
  .embed-wrap iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: none; }

</style>
