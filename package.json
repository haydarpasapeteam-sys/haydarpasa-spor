{
  "name": "haydarpasa-spor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Haydarpaşa Lisesi Beden Eğitimi ve Spor Bölümü — statik Astro sitesi",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run validate && node scripts/optimize-images.mjs && astro build",
    "build:unsafe": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "migrate:legacy": "node scripts/migrate-legacy-content.mjs",
    "validate": "node scripts/validate-content.mjs && node scripts/validate-links.mjs && node scripts/validate-documents.mjs && node scripts/validate-pages-cms-config.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:documents": "node scripts/validate-documents.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "validate:pages-cms": "node scripts/validate-pages-cms-config.mjs",
    "lighthouse": "node scripts/lighthouse-check.mjs"
  },
  "dependencies": {
    "astro": "^7.3.4",
    "sharp": "^0.35.4",
    "@fontsource/plus-jakarta-sans": "^5.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "eslint-plugin-astro": "^1.3.1",
    "fast-glob": "^3.3.3",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4",
    "yaml": "^2.7.0",
    "zod": "^3.24.1",
    "typescript-eslint": "^8.70.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "@eslint/js": "^9.39.5",
    "globals": "^15.14.0",
    "lighthouse": "^13.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
